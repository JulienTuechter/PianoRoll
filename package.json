{
  "name": "pianist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run -s lib -- prepare",
    "build": "tsc -b && vite build && tsx scripts/build-pages.ts",
    "postbuild": "npm run -s lib -- generate && npm run -s lib -- check",
    "build:pages": "tsx scripts/build-pages.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "lib": "tsx --tsconfig scripts/library/tsconfig.json scripts/library/cli.ts",
    "library:stubs": "npm run -s lib -- stubs",
    "library:check": "npm run build",
    "library:verify": "npm run -s lib -- check",
    "library:rename": "npm run -s lib -- rename",
    "seo:ping": "npm run -s lib -- ping",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "merge:main": "node scripts/merge-branch.mjs main",
    "merge:prod": "node scripts/merge-branch.mjs prod",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tonejs/midi": "^2.0.28",
    "idb": "^8.0.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tonal": "^6.5.1",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
